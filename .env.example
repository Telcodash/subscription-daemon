REDIS_URL=redis://127.0.0.1:6379
# Must match the gateway's QUEUE_PREFIX.
QUEUE_PREFIX=queue
QUEUE_NAME=subscriptions
# MSISDN daemon queue (asked for live number assignments when seeding lines).
MSISDN_QUEUE=msisdn
CONCURRENCY=10

DATABASE_PATH=data/subscriptions.sqlite

# Seed the starter tariff catalogue and one line per live number on first boot.
SEED_ON_EMPTY=true
SEED=1
